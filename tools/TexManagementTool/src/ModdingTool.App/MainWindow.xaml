<Window x:Class="ModdingTool.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ModdingTool.App.ViewModels"
        mc:Ignorable="d"
        Title="Texture Workshop" Height="820" Width="1440" MinHeight="620" MinWidth="1080"
        Background="#F3F1EC" FontFamily="Segoe UI" Loaded="OnLoaded" Closing="OnClosing">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#222522" />
        <SolidColorBrush x:Key="Muted" Color="#6D746D" />
        <SolidColorBrush x:Key="Accent" Color="#D9563F" />
        <SolidColorBrush x:Key="Panel" Color="#FCFBF7" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="TextureListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="AllowDrop" Value="True" />
        </Style>
        <ItemsPanelTemplate x:Key="TextureGridPanel">
            <WrapPanel />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="TextureListPanel">
            <VirtualizingStackPanel />
        </ItemsPanelTemplate>
        <Style x:Key="TextureGridItemStyle" TargetType="ListBoxItem">
            <Setter Property="Width" Value="170" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style x:Key="TextureListItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <ItemsPanelTemplate x:Key="OutputGroupListPanel">
            <VirtualizingStackPanel />
        </ItemsPanelTemplate>
        <GroupStyle x:Key="OutputGroupStyle" Panel="{StaticResource OutputGroupListPanel}">
            <GroupStyle.ContainerStyle>
                <Style TargetType="GroupItem">
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="GroupItem">
                                <Border Background="{Binding Name.Background}" BorderBrush="#C8CBC4" BorderThickness="1"
                                    CornerRadius="4" Margin="0,5" Padding="8" HorizontalAlignment="Stretch"
                                    Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                    <Grid>
                                        <Expander x:Name="GroupDrawer" IsExpanded="{Binding Name.IsExpanded, Mode=OneTime}"
                                              HorizontalContentAlignment="Stretch"
                                              Expanded="OutputGroupExpanded" Collapsed="OutputGroupCollapsed">
                                            <Expander.Header>
                                                <TextBlock Text="{Binding Name.Name}" FontFamily="Bahnschrift"
                                                           FontWeight="SemiBold" FontSize="13" Margin="4,2,8,6" />
                                            </Expander.Header>
                                            <ItemsPresenter />
                                        </Expander>
                                        <StackPanel x:Name="UngroupedSection" Visibility="Collapsed">
                                            <TextBlock Text="UNGROUPED" FontFamily="Bahnschrift" FontWeight="SemiBold"
                                                       FontSize="12" Foreground="{StaticResource Muted}" Margin="4,2,8,6" />
                                            <ItemsPresenter />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Name.Id}" Value="{x:Null}">
                                        <Setter TargetName="GroupDrawer" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="UngroupedSection" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </GroupStyle.ContainerStyle>
        </GroupStyle>
        <ContextMenu x:Key="OriginalTextureContextMenu" x:Shared="False">
            <MenuItem Header="Mark as seen" Click="MarkOriginalsSeen" />
            <MenuItem Header="Mark as unseen" Click="MarkOriginalsUnseen" />
            <Separator />
            <MenuItem Header="Mark as TODO" Click="MarkOriginalsTodo" />
            <MenuItem Header="Clear TODO" Click="ClearOriginalsTodo" />
        </ContextMenu>
        <ContextMenu x:Key="OutputTextureContextMenu" x:Shared="False">
            <MenuItem Header="Open image" Click="OpenOutputImage" />
            <MenuItem Header="Open original image" Click="OpenOutputOriginalImage" />
            <Separator />
            <MenuItem Header="Mark as unfinished" Click="MarkOutputsUnfinished" />
            <MenuItem Header="Clear unfinished" Click="ClearOutputsUnfinished" />
            <Separator />
            <MenuItem Header="Create group from texture" Click="CreateGroupFromTexture" />
            <MenuItem Header="Rename group" Click="RenameGroupFromMenu" />
            <MenuItem Header="Remove from group" Click="RemoveFromGroup" />
            <Separator />
            <MenuItem Header="Move texture up" Click="MoveTextureUp" />
            <MenuItem Header="Move texture down" Click="MoveTextureDown" />
        </ContextMenu>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <DataTemplate x:Key="TextureTemplate" DataType="{x:Type vm:TextureItemViewModel}">
            <Grid Width="150" Height="178" Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="136" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Background="#E9E8E2" BorderBrush="#D1D2CB" BorderThickness="1" CornerRadius="3">
                    <Grid>
                           <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="7" RenderOptions.BitmapScalingMode="HighQuality"
                               Loaded="ThumbnailLoaded" />
                        <Border Background="#CCB5332A" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5"
                                Padding="5,2" CornerRadius="2" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="ERROR" Foreground="White" FontSize="10" FontWeight="Bold" />
                        </Border>
                        <Border Background="#CC36705A" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5"
                                Padding="5,2" CornerRadius="2" Visibility="{Binding IsSeen, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="SEEN" Foreground="White" FontSize="10" FontWeight="Bold" />
                        </Border>
                        <Border Background="#D6C88A24" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="5"
                                Padding="5,2" CornerRadius="2" Visibility="{Binding IsTodo, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="TODO" Foreground="White" FontSize="10" FontWeight="Bold" />
                        </Border>
                        <Border Background="#D6B45B21" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="5"
                                Padding="5,2" CornerRadius="2" Visibility="{Binding IsUnfinished, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="UNFINISHED" Foreground="White" FontSize="10" FontWeight="Bold" />
                        </Border>
                    </Grid>
                </Border>
                <StackPanel Grid.Row="1" Margin="2,5,2,0">
                    <TextBlock Text="{Binding FileName}" Foreground="{StaticResource Ink}" FontSize="12" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding GroupName}" Foreground="{StaticResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="TextureListTemplate" DataType="{x:Type vm:TextureItemViewModel}">
            <Grid Height="52" Margin="3,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="54" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <Border Background="#E9E8E2" BorderBrush="#D1D2CB" BorderThickness="1" CornerRadius="2" Margin="2">
                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="3" Loaded="ThumbnailLoaded" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                    <TextBlock Text="{Binding FileName}" Foreground="{StaticResource Ink}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding CopySourceFileName, TargetNullValue=Base image}" Foreground="{StaticResource Muted}" FontSize="10" />
                    <TextBlock Text="UNFINISHED" Foreground="#9B4C20" FontSize="10" FontWeight="Bold"
                               Visibility="{Binding IsUnfinished, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding GroupName}" Foreground="{StaticResource Muted}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="5" />
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#222522" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="TEXTURE WORKSHOP" Foreground="White" FontFamily="Bahnschrift" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock Text="Flycast replacement workspace" Foreground="#ADB4AD" FontSize="11" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="30,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding OriginalFolder, TargetNullValue=Original folder not selected}" Foreground="#D7DBD6" FontSize="11" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding OutputFolder, TargetNullValue=Modified folder not selected}" Foreground="#D7DBD6" FontSize="11" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Original folder" Click="ChooseOriginalFolder" />
                    <Button Content="Modified folder" Click="ChooseOutputFolder" />
                    <Button Content="List / Grid" Click="ToggleView" Margin="0" />
                </StackPanel>
            </Grid>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="#E1DFD8" Padding="14,8" BorderBrush="#C8C6BF" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}" />
        </Border>
        <Grid Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" MinWidth="350" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="5*" MinWidth="350" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="310" />
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource Panel}" BorderBrush="#D3D1C9" BorderThickness="1" CornerRadius="4">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="14,11" BorderBrush="#DDDAD2" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <ComboBox SelectedValue="{Binding LeftPaneSource}" SelectedValuePath="Tag"
                                      HorizontalAlignment="Stretch" FontFamily="Bahnschrift" FontWeight="SemiBold" Padding="7,4">
                                <ComboBoxItem Content="ORIGINAL TEXTURES" Tag="{x:Static vm:PaneSource.Originals}" />
                                <ComboBoxItem Content="MODIFIED / LIVE OUTPUT" Tag="{x:Static vm:PaneSource.Output}" />
                            </ComboBox>
                            <Grid Margin="0,9,0,0">
                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsLeftOriginals, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <CheckBox Content="Hide seen" IsChecked="{Binding HideSeenOriginals, Mode=OneWay}"
                                              VerticalAlignment="Center" Margin="0,0,14,0" Checked="HideSeenChanged" Unchecked="HideSeenChanged" />
                                    <CheckBox Content="Hide TODO" IsChecked="{Binding HideTodoOriginals, Mode=OneWay}"
                                              VerticalAlignment="Center" Margin="0,0,14,0" Checked="HideTodoChanged" Unchecked="HideTodoChanged" />
                                    <Button Content="‹" ToolTip="Previous page" Click="PreviousOriginalPage" IsEnabled="{Binding CanShowPreviousOriginals}" Padding="9,3" />
                                    <TextBlock VerticalAlignment="Center" Margin="4,0,12,0">
                                        <Run Text="{Binding OriginalPage}" /><Run Text=" / " /><Run Text="{Binding OriginalPageCount}" />
                                    </TextBlock>
                                    <Button Content="›" ToolTip="Next page" Click="NextOriginalPage" IsEnabled="{Binding CanShowNextOriginals}" Padding="9,3" Margin="0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsLeftOutput, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <CheckBox Content="Hide groups" IsChecked="{Binding LeftHideGroups}" Margin="0,0,16,0" />
                                    <CheckBox Content="Only unfinished" IsChecked="{Binding LeftOnlyUnfinished}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Grid>
                        <ListBox x:Name="LeftOriginalList" ItemsSource="{Binding Originals}" ItemTemplate="{StaticResource TextureTemplate}"
                                 Style="{StaticResource TextureListStyle}" HorizontalContentAlignment="Left"
                                 ItemContainerStyle="{StaticResource TextureGridItemStyle}"
                                 Visibility="{Binding IsLeftOriginals, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 PreviewMouseLeftButtonDown="TextureListMouseDown" PreviewMouseMove="TextureListMouseMove"
                                 MouseDoubleClick="TextureDoubleClick" PreviewMouseRightButtonDown="PaneListRightButtonDown"
                                 SelectionChanged="TextureSelectionChanged" DragOver="PaneDragOver" SelectionMode="Extended"
                                 ItemsPanel="{StaticResource TextureGridPanel}" ContextMenu="{StaticResource OriginalTextureContextMenu}" />
                        <ListBox x:Name="LeftOutputList" ItemsSource="{Binding LeftOutputView}" ItemTemplate="{StaticResource TextureTemplate}"
                                 Style="{StaticResource TextureListStyle}" HorizontalContentAlignment="Left"
                                 ItemContainerStyle="{StaticResource TextureGridItemStyle}"
                                 Visibility="{Binding IsLeftOutput, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 PreviewMouseLeftButtonDown="TextureListMouseDown" PreviewMouseMove="TextureListMouseMove"
                                 MouseDoubleClick="TextureDoubleClick" PreviewMouseRightButtonDown="PaneListRightButtonDown"
                                 SelectionChanged="TextureSelectionChanged" DragOver="PaneDragOver" Drop="OutputDrop"
                                 SelectionMode="Extended" ItemsPanel="{StaticResource TextureGridPanel}"
                                 ContextMenu="{StaticResource OutputTextureContextMenu}">
                            <ListBox.GroupStyle><StaticResource ResourceKey="OutputGroupStyle" /></ListBox.GroupStyle>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />
            <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="#D3D1C9" BorderThickness="1" CornerRadius="4">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="14,11" BorderBrush="#DDDAD2" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <ComboBox SelectedValue="{Binding RightPaneSource}" SelectedValuePath="Tag"
                                      HorizontalAlignment="Stretch" FontFamily="Bahnschrift" FontWeight="SemiBold" Padding="7,4">
                                <ComboBoxItem Content="ORIGINAL TEXTURES" Tag="{x:Static vm:PaneSource.Originals}" />
                                <ComboBoxItem Content="MODIFIED / LIVE OUTPUT" Tag="{x:Static vm:PaneSource.Output}" />
                            </ComboBox>
                            <Grid Margin="0,9,0,0">
                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsRightOriginals, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <CheckBox Content="Hide seen" IsChecked="{Binding HideSeenOriginals, Mode=OneWay}"
                                              VerticalAlignment="Center" Margin="0,0,14,0" Checked="HideSeenChanged" Unchecked="HideSeenChanged" />
                                    <CheckBox Content="Hide TODO" IsChecked="{Binding HideTodoOriginals, Mode=OneWay}"
                                              VerticalAlignment="Center" Margin="0,0,14,0" Checked="HideTodoChanged" Unchecked="HideTodoChanged" />
                                    <Button Content="‹" ToolTip="Previous page" Click="PreviousOriginalPage" IsEnabled="{Binding CanShowPreviousOriginals}" Padding="9,3" />
                                    <TextBlock VerticalAlignment="Center" Margin="4,0,12,0">
                                        <Run Text="{Binding OriginalPage}" /><Run Text=" / " /><Run Text="{Binding OriginalPageCount}" />
                                    </TextBlock>
                                    <Button Content="›" ToolTip="Next page" Click="NextOriginalPage" IsEnabled="{Binding CanShowNextOriginals}" Padding="9,3" Margin="0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsRightOutput, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <CheckBox Content="Hide groups" IsChecked="{Binding RightHideGroups}" Margin="0,0,16,0" />
                                    <CheckBox Content="Only unfinished" IsChecked="{Binding RightOnlyUnfinished}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Grid>
                        <ListBox x:Name="RightOriginalList" ItemsSource="{Binding Originals}" ItemTemplate="{StaticResource TextureTemplate}"
                                 Style="{StaticResource TextureListStyle}" HorizontalContentAlignment="Left"
                                 ItemContainerStyle="{StaticResource TextureGridItemStyle}"
                                 Visibility="{Binding IsRightOriginals, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 PreviewMouseLeftButtonDown="TextureListMouseDown" PreviewMouseMove="TextureListMouseMove"
                                 MouseDoubleClick="TextureDoubleClick" PreviewMouseRightButtonDown="PaneListRightButtonDown"
                                 SelectionChanged="TextureSelectionChanged" DragOver="PaneDragOver" SelectionMode="Extended"
                                 ItemsPanel="{StaticResource TextureGridPanel}" ContextMenu="{StaticResource OriginalTextureContextMenu}" />
                        <ListBox x:Name="RightOutputList" ItemsSource="{Binding RightOutputView}" ItemTemplate="{StaticResource TextureTemplate}"
                                 Style="{StaticResource TextureListStyle}" HorizontalContentAlignment="Left"
                                 ItemContainerStyle="{StaticResource TextureGridItemStyle}"
                                 Visibility="{Binding IsRightOutput, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 PreviewMouseLeftButtonDown="TextureListMouseDown" PreviewMouseMove="TextureListMouseMove"
                                 MouseDoubleClick="TextureDoubleClick" PreviewMouseRightButtonDown="PaneListRightButtonDown"
                                 SelectionChanged="TextureSelectionChanged" DragOver="PaneDragOver" Drop="OutputDrop"
                                 SelectionMode="Extended" ItemsPanel="{StaticResource TextureGridPanel}"
                                 ContextMenu="{StaticResource OutputTextureContextMenu}">
                            <ListBox.GroupStyle><StaticResource ResourceKey="OutputGroupStyle" /></ListBox.GroupStyle>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="3" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />
            <Border Grid.Column="4" Background="{StaticResource Panel}" BorderBrush="#D3D1C9" BorderThickness="1" CornerRadius="4" Padding="16">
                <StackPanel DataContext="{Binding SelectedTexture}">
                    <TextBlock Text="INSPECTOR" FontFamily="Bahnschrift" FontSize="16" FontWeight="SemiBold" />
                    <Border Height="230" Background="#E9E8E2" BorderBrush="#D1D2CB" BorderThickness="1" CornerRadius="3" Margin="0,14,0,12">
                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="10" Loaded="ThumbnailLoaded" />
                    </Border>
                    <TextBlock Text="{Binding FileName, TargetNullValue=Select a texture}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding FullPath}" Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,18" />
                    <StackPanel Visibility="{Binding IsOutput, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="COPY IMAGE" FontSize="11" FontWeight="Bold" />
                    <Border AllowDrop="True" DragOver="CopyImageDragOver" Drop="CopyImageDrop" Background="#F4E8D4"
                            BorderBrush="#C99A54" BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,6,0,7">
                        <TextBlock Text="{Binding CopySourceFileName, TargetNullValue=Drop a modified image here}" TextTrimming="CharacterEllipsis" />
                    </Border>
                    <Button Content="Clear Copy Image" Click="ClearCopy" HorizontalAlignment="Left" Margin="0,0,0,16" />
                    <TextBlock Text="BRIGHTNESS" FontSize="11" FontWeight="Bold" />
                    <Grid Margin="0,5,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                        <Slider Minimum="0" Maximum="100" TickFrequency="5" Value="{Binding Brightness}" IsEnabled="{Binding HasCopySource}" />
                        <TextBlock Grid.Column="1" Text="{Binding Brightness, StringFormat={}{0}%}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Button Content="Save brightness" Click="SaveBrightness" HorizontalAlignment="Left" Margin="0,0,0,20" />
                    <Separator />
                    <TextBlock Text="GROUP" FontSize="11" FontWeight="Bold" Margin="0,16,0,5" />
                    <TextBox x:Name="GroupNameBox" Text="{Binding GroupName}" Padding="7" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Rename" Click="RenameGroup" />
                        <Button Content="Ungroup" Click="Ungroup" />
                    </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
